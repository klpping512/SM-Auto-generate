# Copy this file to .env and fill in your own key. Do not commit the real file.
# 素材视觉理解（阿里云百炼 OpenAI 兼容接口，仅作可选遗留能力）
DASHSCOPE_API_KEY=your_dashscope_api_key

# 视频旁白可使用 MiMo 或 MiniMax Speech（见下方 TTS_PROVIDER / *_TTS_*）。
# DashScope Key 用于遗留视觉/文本能力，不是旁白必需项。

# 成片 MiMo 质检默认开启；自动重新生成默认关闭，先人工确认报告。
VIDEO_QUALITY_ENABLED=1
VIDEO_QUALITY_AUTO_REGENERATE=0

# 可选：本地 faster-whisper 模型目录。项目生成视频已有字幕时不会调用 ASR。
ASSET_ASR_MODEL_PATH=

# 可选：统一代理，同时作用于 YouTube 元数据抓取与新闻 RSS 抓取；留空时直连。
# 填本机代理客户端(Clash Verge 等)开的监听端口，不是订阅链接。
# HTTP 端口示例 http://127.0.0.1:7897；SOCKS5 示例 socks5://127.0.0.1:7891
SA_HOTSPOT_PROXY=http://127.0.0.1:7897
# 旧变量，仅作用于 YouTube；设置了 SA_HOTSPOT_PROXY 时可留空。
SA_YOUTUBE_PROXY=
# 热点母片下载总超时（秒）。默认 300；代理慢或长视频可再调高。
HOTSPOT_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=300
# 母片提速：分析档画质（默认 480）；定稿 confirmed hook 用 FINAL（默认 720）。
SA_HOTSPOT_ANALYSIS_HEIGHT=480
SA_HOTSPOT_FINAL_HEIGHT=720
# 长视频分析档采样。多窗真修完成前保持 MULTIWINDOW=0（单一连续窗，避免 offsets 虚报与 duration 被焊死）。
SA_HOTSPOT_MULTIWINDOW=0
SA_HOTSPOT_SINGLE_WINDOW_SEC=120
# 多窗开启后：单窗秒数 / 总采样秒数上限。
SA_HOTSPOT_SAMPLE_WINDOW_SEC=60
SA_HOTSPOT_SAMPLE_MAX_TOTAL_SEC=300
# 母片下载+分析有界并发（默认 3，硬上限 5；设 1 退回串行）。
SA_HOTSPOT_DL_CONCURRENCY=3
# P2 双层模型：audit 快速档开关（默认关；须 A/B 过关后才开）。
SA_HOTSPOT_AUDIT_FAST=0

# 可选：覆盖 YouTube 视频信源清单（JSON 数组，**整体替换**不是追加；须含全部要保留频道）。
# 非法 JSON / 空值 / 全部条目不合规时会静默回落到 DEFAULT_YOUTUBE_CHANNELS。
# 批22默认纳入官方机构、港口/道路和可信新闻频道；系统只读取元数据，实际下载由管理员授权范围决定。
# 例：SA_HOTSPOT_VIDEO_CHANNELS_JSON=[{"name":"eNCA","url":"https://www.youtube.com/channel/UCI3RT5PGmdi1KVp9FG_CneA"}]
SA_HOTSPOT_VIDEO_CHANNELS_JSON=
# 每频道每轮读取的最近视频条数（仅元数据，不下载）。默认 8，最大 24。
HOTSPOT_YOUTUBE_CHANNEL_VIDEO_LIMIT=8
# YouTube 每条视频格式预检：默认关闭，避免单个 -F 请求卡住整轮信源。
# 下载阶段仍会真实校验格式并记录逐条失败；严格回填时可设为 1。
HOTSPOT_YOUTUBE_PRECHECK=0

# 素材生命周期：默认每日只做预演，不会删除文件。验证预览后才把 DRY_RUN 改为 0。
MEDIA_CLEANUP_ENABLED=1
MEDIA_CLEANUP_DRY_RUN=1
HOTSPOT_SOURCE_RETENTION_DAYS=7
FINAL_VIDEO_RETENTION_DAYS=30
INTERMEDIATE_RETENTION_DAYS=7
FAILED_TEMP_RETENTION_HOURS=24
MODEL_CACHE_TTL_DAYS=30
MODEL_CACHE_MAX_ROWS=5000
MEDIA_DISK_GC_PERCENT=30
MEDIA_DISK_DEGRADE_PERCENT=20
MEDIA_DISK_STOP_PERCENT=10
MEDIA_DISK_RESERVE_BYTES=0
VIDEO_HEAVY_CONCURRENCY=1
# 素材语义分析并发；taxonomy 重建时可提到 3，正式成片时保持 2。
MEDIA_ANALYSIS_CONCURRENCY=2
# 单条母片远程视觉抽样上限；重建期可降到 24 换吞吐，完整入库仍可用更高值。
ASSET_MAX_REMOTE_VISUAL_SEGMENTS=24
# 1=存量重建复用已有预览/字幕，只重跑视觉打标（显著加速）。
ASSET_TAXONOMY_REUSE_MEDIA=1
DOWNLOAD_CONCURRENCY=2
SCENE_TTS_CONCURRENCY=2
SCENE_FFMPEG_CONCURRENCY=2
# 兼容旧部署变量；批22起不再参与权限判断，管理员配置的信源直接进入授权库。
HOTSPOT_CONFIGURED_SOURCES_AUTHORIZED=1
# 热点 Hook 库：每三天由内置 Qwen 从已授权长视频中决定哪些值得下载；
# 下载后再由 Qwen 从已分析母片中筛出带“画面发生/物流切入”的精华片段。
HOTSPOT_HOOK_SYNC_ENABLED=1
# 预热最短时长门槛（秒）。0 表示不过滤；配置 180 会把大量 1-3 分钟的
# 新闻短片挡在 Hook 库外，除非明确有容量压力否则保持 0。
HOTSPOT_PREWARM_MIN_DURATION_SECONDS=0
# 批22：以完整 12 天周期清理 Hook 派生素材；默认仅 dry-run，禁止按年龄粗删。
HOTSPOT_HOOK_CLEANUP_ENABLED=0
HOTSPOT_HOOK_CYCLE_DAYS=12
HOTSPOT_HOOK_MIN_CYCLE_QUALIFIED=40
HOTSPOT_HOOK_CYCLE_ANCHOR=2026-08-01T00:00:00+00:00
HOTSPOT_HOOK_REQUIRE_OPS_RECORDS=0
HOTSPOT_HOOK_RETENTION_DAYS=12
HOTSPOT_HOOK_PROTECT_DAYS=0
HOTSPOT_HOOK_CLEANUP_HOUR=3
HOTSPOT_HOOK_CLEANUP_MINUTE=15
# 开放许可图片源：只保留可回溯许可证和署名，且不把配图冒充事件现场。
HOTSPOT_COMMONS_IMAGE_ENABLED=1
HOTSPOT_INSPIRATION_SYNC_ENABLED=0
# 每次 6h 抓取后增量 Hook 入库批大小（高优先级已授权候选）。
HOTSPOT_INCREMENTAL_HOOK_BATCH=8

# 空库首次启动必填；已有用户时忽略。禁止依赖默认 admin/admin123。
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员

# 旁白 TTS：默认 MiMo；MiniMax 使用中国区 Token Plan Key。
TTS_PROVIDER=mimo
MIMO_API_KEY=
MINIMAX_TOKEN_PLAN_KEY=
MINIMAX_TTS_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_VOICE=male-qn-qingse
# 云端 1080p 分镜渲染：4 核机器建议 veryfast + 3 路并发；质量仍由最终门禁和 ffprobe 检查。
RENDER_PRESET=veryfast
SCENE_FFMPEG_CONCURRENCY=3
RENDER_TIMEOUT_SECONDS=900
# 文本/视觉角色由 model_role_configs 路由表管理：
# 文本可用 minimax_openai + https://api.minimaxi.com/v1 + MiniMax-M3；
# 视觉可用 minimax_anthropic + https://api.minimaxi.com/anthropic + MiniMax-M3。
# OpenCode Go uses the OpenAI-compatible chat/completions endpoint for the
# models listed in docs; configure text roles in Platform Config, never put a
# real key in this tracked example file.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=glm-5.2
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=mimo_default
TTS_FALLBACK_PROVIDER=qwen
TTS_FALLBACK_ENABLED=1

# 可选：服务器挂载素材盘时填写；留空则使用项目 static 目录。
# za-stock 管线下载根 = <LOCAL_ASSET_ROOT>/za-stock（缺省 ~/Desktop/视频&图片素材/za-stock）。
LOCAL_ASSET_ROOT=

# 可选：南非免版权 b-roll（scripts/pull_za_stock.py）。缺哪个源就跳过哪个，不报错。
# 申请：https://www.pexels.com/api/ 与 https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# 可选：允许跨源访问 API 的来源列表（逗号分隔）。默认只允许本机访问；
# 如果前端不是和后端同源部署，需要显式加上前端的完整 origin。
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# 可选：JWT 签名密钥。留空时会在 data/.jwt_secret 自动生成并持久化一份随机密钥，
# 不需要手动配置；生产多实例部署时建议显式设置，保证各实例签的 token 互认。
JWT_SECRET=

# 可选：账号凭据（Cookie/Token JSON）静态加密密钥（Fernet）。
# 留空时会在 data/.credential_key 自动生成；务必备份，丢失后旧密文无法解密。
CREDENTIAL_ENCRYPTION_KEY=
